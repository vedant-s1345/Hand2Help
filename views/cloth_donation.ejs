<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Cloth Donation</h1>
    <table border="1">
        
        <tr>
            <th>Event Manager</th>
            <th>Address</th>
            <th>Event Date</th>
            <th>Discription</th>
            <th>No. of Volunteers</th>
        </tr>
        <% for ( event of events ) {%>
            <tr>
                <td><%= event.uusername %></td>
                <td><%= event.address %></td>
                <td><%= event.event_date %></td>
                <td><%= event.disc %></td>
                <td><%= event.no_volunteers %></td>
                <td>
                    <form action="/volunteer_home/<%= volunteer.vid %>/cloth_donation/<%= event.eid %>" method="POST">
                        <button type="submit">Select</button>
                    </form>
                </td>
            </tr>
        <% } %>
    
    </table>
</body>
</html>